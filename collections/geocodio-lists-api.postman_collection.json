  "info": {
    "_postman_id": "d72ce503-27ae-479c-8709-728af7059231",
    "name": "Geocodio Batch Lists API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Geocodio is a US and Canada geocoding API for forward geocoding (address to coordinates), reverse geocoding (coordinates to address), batch geocoding of up to 10,000 records, asynchronous spreadsheet list jobs, and data appends that enrich results with congressional districts, state legislative districts, census geographies, ACS demographics, school districts, ZIP+4, timezone, and Canadian electoral data. Requests are authenticated with an api_key query parameter and the first 2,500 lookups per day are free.\n\nContact Support:\n Name: Geocodio Support\n Email: support@geocod.io",
      "type": "text/plain"
    }
  }
